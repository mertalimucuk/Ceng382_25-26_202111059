@page
@model Week5Lab.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<style>
    .custom-gold {
        background-color: #34925E;
        color: black;
        font-weight: 500;
        border: none;
        border-radius: 6px;
    }

    .custom-gold:hover {
        background-color: #34925E;
    }

    .page-link,
    .page-item.active .page-link {
        background-color: white !important;
        border-color: white !important;
        color: #8b4513 !important;
    }

    .page-item .page-link:hover {
        background-color: #8b4513 !important;
        border-color: #8b4513 !important;
    }

    h4 {
        color: #1c1c1c;
        font-weight: 600;
    }
</style>

<!-- ✅ Kullanıcı bilgisi gösterimi (sadece Username üzerinden) -->
@if (Model.Username != null)
{
    <div class="alert alert-success d-flex justify-content-between align-items-center">
        <div>
            👤 <strong>@Model.Username</strong>
        </div>
        <form method="post" asp-page="/Identity/Account/Logout">
            <button type="submit" class="btn btn-sm btn-outline-danger">Logout</button>
        </form>
    </div>
}

<div class="container mt-5 p-4 card-blur">
    <div class="row">
        <!-- Left Column: Add/Edit Class -->
        <div class="col-md-4">
            <h4>@(Model.EditableClass.Id == 0 ? "Add New Class" : "Edit Class")</h4>
            <form method="post" asp-page-handler="@(Model.EditableClass.Id == 0 ? "Add" : "Update")">
                <input type="hidden" asp-for="EditableClass.Id" />
                <div class="mb-2">
                    <input asp-for="EditableClass.ClassName" class="form-control" placeholder="Class Name" required />
                </div>
                <div class="mb-2">
                    <input asp-for="EditableClass.StudentCount" class="form-control" placeholder="Student Count" required />
                </div>
                <div class="mb-2">
                    <input asp-for="EditableClass.Description" class="form-control" placeholder="Description" required />
                </div>
                <button type="submit" class="btn custom-gold">
                    @(Model.EditableClass.Id == 0 ? "Add Class" : "Update Class")
                </button>
            </form>
        </div>

        <!-- Right Column: Table + Search + Export -->
        <div class="col-md-8">
            <!-- Search -->
            <form method="get" class="d-flex mb-3">
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search" class="form-control me-2" />
                <button type="submit" class="btn btn-primary">Filter</button>
            </form>

            <h3>Class List</h3>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredList)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" asp-page-handler="Edit" asp-route-id="@item.Id" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">✏️</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">🗑️</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Export + Import Bölümü -->
            <div class="d-flex gap-2 mb-3">
                <form method="post" asp-page-handler="ExportFiltered">
                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                    <div class="d-flex flex-column gap-2">
                        <span class="fw-semibold text-white">Select columns to export:</span>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-outline-primary toggle-column" data-column="ClassName">Class Name</button>
                            <button type="button" class="btn btn-outline-primary toggle-column" data-column="StudentCount">Student Count</button>
                            <button type="button" class="btn btn-outline-primary toggle-column" data-column="Description">Description</button>
                        </div>
                        <div id="selectedColumnsContainer"></div>
                        <button type="submit" class="btn btn-primary mt-2">Export All JSON</button>
                    </div>
                </form>

                <form method="post" asp-page-handler="Import">
                    <button type="submit" class="btn custom-gold mt-2">Import JSON to DB</button>
                </form>
            </div>

            <!-- Pagination -->
            <div class="mt-3 d-flex justify-content-between align-items-center">
                <a asp-page="./Index"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                   class="btn btn-outline-secondary @(Model.PageNumber <= 1 ? "disabled" : "")">
                    Previous
                </a>

                <span class="text-white">Page @Model.PageNumber of @Model.TotalPages</span>

                <a asp-page="./Index"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                   class="btn btn-outline-secondary @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    Next
                </a>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link" href="?PageNumber=@i&SearchTerm=@Model.SearchTerm">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const selectedColumns = new Set(["ClassName", "StudentCount", "Description"]);
        const container = document.getElementById("selectedColumnsContainer");

        function updateHiddenInputs() {
            container.innerHTML = "";
            selectedColumns.forEach(col => {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "SelectedColumns";
                input.value = col;
                container.appendChild(input);
            });
        }

        document.querySelectorAll(".toggle-column").forEach(btn => {
            const col = btn.dataset.column;
            btn.classList.add("btn-primary");

            btn.addEventListener("click", () => {
                if (selectedColumns.has(col)) {
                    selectedColumns.delete(col);
                    btn.classList.remove("btn-primary");
                    btn.classList.add("btn-outline-primary");
                } else {
                    selectedColumns.add(col);
                    btn.classList.add("btn-primary");
                    btn.classList.remove("btn-outline-primary");
                }

                updateHiddenInputs();
            });
        });

        updateHiddenInputs();
    </script>
}

