@page
@model Week5Lab.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!-- Kullanıcı bilgisi gösterimi -->
@if (Model.Username != null && Model.SessionId != null)
{
    <div class="alert alert-success d-flex justify-content-between align-items-center">
        <span>
            👤 Welcome, <strong>@Model.Username</strong> |
            Session ID: <code>@Model.SessionId</code>
        </span>
        <form method="post" asp-page-handler="Logout" class="mb-0">
            <button type="submit" class="btn btn-sm btn-outline-danger">Logout</button>
        </form>
    </div>
}


<div class="container mt-5 p-4 card-blur">
    <!-- Filter -->
    <form method="get" class="mb-4 d-flex">
        <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search class name..." class="form-control me-2" />
        <button type="submit" class="btn btn-primary">Filter</button>
    </form>

    <div class="row">
        <!-- Left: Add/Edit Form -->
        <div class="col-md-6">
            <h3>@(Model.IsEditing ? "Edit Class" : "Add New Class")</h3>
            <form method="post">
                <input type="hidden" asp-for="NewClass.Id" />
                <div class="form-group mb-2">
                    <label>Class Name</label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                </div>
                <div class="form-group mb-2">
                    <label>Student Count</label>
                    <input asp-for="NewClass.StudentCount" class="form-control" />
                </div>
                <div class="form-group mb-2">
                    <label>Description</label>
                    <input asp-for="NewClass.Description" class="form-control" />
                </div>
                <button type="submit" asp-page-handler="@(Model.IsEditing ? "Update" : "Add")" class="btn btn-primary">
                    @(Model.IsEditing ? "Edit Class" : "Add Class")
                </button>
            </form>
        </div>

        <!-- Right: Table + Export -->
        <div class="col-md-6">
            <h3>Class List</h3>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredList)
                    {
                        var originalItem = Week5Lab.Pages.IndexModel.ClassList.FirstOrDefault(c =>
                            c.ClassName == item.ClassName &&
                            c.Description == item.Description &&
                            c.StudentCount == item.StudentCount);

                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@originalItem?.Id" />
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-link text-danger p-0">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@originalItem?.Id" />
                                    <button type="submit" asp-page-handler="Edit" class="btn btn-link text-primary p-0 ms-2">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Export buttons -->
            <div class="d-flex gap-2 mb-3">
                <form method="post" asp-page-handler="Export">
                    <button type="submit" class="btn btn-primary">Export All JSON</button>
                </form>

                <form method="post" asp-page-handler="ExportFiltered">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <span class="fw-semibold">Select columns to export:</span>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedColumns" value="ClassName" checked />
                            <label class="form-check-label">Class Name</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedColumns" value="StudentCount" checked />
                            <label class="form-check-label">Student Count</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedColumns" value="Description" checked />
                            <label class="form-check-label">Description</label>
                        </div>

                        <button type="submit" class="btn btn-secondary">Export Filtered</button>
                    </div>
                </form>
            </div>

            <!-- Pagination Controls -->
            <div class="mt-3 d-flex justify-content-between align-items-center">
                <a asp-page="./Index"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                   class="btn btn-outline-secondary @(Model.PageNumber <= 1 ? "disabled" : "")">
                    Previous
                </a>

                <span style="color:#0d6efd">Page @Model.PageNumber of @Model.TotalPages</span>

                <a asp-page="./Index"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                   class="btn btn-outline-secondary @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    Next
                </a>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link" href="?PageNumber=@i&SearchTerm=@Model.SearchTerm">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
