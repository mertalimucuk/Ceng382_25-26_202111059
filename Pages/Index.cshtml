@page
@model Week5Lab.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!-- Kullanıcı bilgisi gösterimi (Hem Session hem Cookie üzerinden) -->
@if (Model.Username != null && Model.SessionId != null)
{
    <div class="alert alert-success d-flex justify-content-between align-items-center">
        <div>
            👤 <strong>@Model.Username</strong> | 
            Session ID: <code>@Model.SessionId</code><br />
            🍪 Cookie Username: <strong>@Model.CookieUsername</strong>
        </div>
        <form method="post" asp-page-handler="Logout" class="mb-0">
            <button type="submit" class="btn btn-sm btn-outline-danger">Logout</button>
        </form>
    </div>
}

<div class="container mt-5 p-4 card-blur">
    <div class="row">
        <!-- Başlıklar hizalı ve üstte -->
        <div class="col-md-6">
            <h3 class="mb-4">Add New Class</h3>
        </div>
        <div class="col-md-6">
            <h3 class="mb-4">Class List</h3>
        </div>
    </div>

    <div class="row">
        <!-- Left Column: Add/Edit Form -->
        <div class="col-md-6">
            <form method="post">
                <input type="hidden" asp-for="NewClass.Id" />
                <div class="form-group mb-2">
                    <label>Class Name</label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                </div>
                <div class="form-group mb-2">
                    <label>Student Count</label>
                    <input asp-for="NewClass.StudentCount" class="form-control" />
                </div>
                <div class="form-group mb-2">
                    <label>Description</label>
                    <input asp-for="NewClass.Description" class="form-control" />
                </div>
                <button type="submit" asp-page-handler="@(Model.IsEditing ? "Update" : "Add")" class="btn btn-primary">
                    @(Model.IsEditing ? "Edit Class" : "Add Class")
                </button>
            </form>
        </div>

        <!-- Right Column: Table + Search + Export -->
        <div class="col-md-6">
            <!-- Search -->
            <form method="get" class="d-flex mb-3">
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search" class="form-control me-2" />
                <button type="submit" class="btn btn-primary">Filter</button>
            </form>

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredList)
                    {
                        var originalItem = Week5Lab.Pages.IndexModel.ClassList.FirstOrDefault(c =>
                            c.ClassName == item.ClassName &&
                            c.Description == item.Description &&
                            c.StudentCount == item.StudentCount);

                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@originalItem?.Id" />
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-link text-danger p-0">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@originalItem?.Id" />
                                    <button type="submit" asp-page-handler="Edit" class="btn btn-link text-primary p-0 ms-2">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Export Bölümü -->
            <div class="d-flex gap-2 mb-3">
                <form method="post" asp-page-handler="ExportFiltered">
                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                    <div class="d-flex flex-column gap-2">
                        <span class="fw-semibold text-white">Select columns to export:</span>

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-outline-primary toggle-column" data-column="ClassName">Class Name</button>
                            <button type="button" class="btn btn-outline-primary toggle-column" data-column="StudentCount">Student Count</button>
                            <button type="button" class="btn btn-outline-primary toggle-column" data-column="Description">Description</button>
                        </div>

                        <div id="selectedColumnsContainer"></div>

                        <button type="submit" class="btn btn-primary mt-2">Export All JSON</button>
                    </div>
                </form>
            </div>

            <!-- Pagination -->
            <div class="mt-3 d-flex justify-content-between align-items-center">
                <a asp-page="./Index"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                   class="btn btn-outline-secondary @(Model.PageNumber <= 1 ? "disabled" : "")">
                    Previous
                </a>

                <span class="text-white">Page @Model.PageNumber of @Model.TotalPages</span>

                <a asp-page="./Index"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                   class="btn btn-outline-secondary @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    Next
                </a>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link" style="background-color: #8b4513; color: white; border: none; margin: 0 2px;" href="?PageNumber=@i&SearchTerm=@Model.SearchTerm">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const selectedColumns = new Set(["ClassName", "StudentCount", "Description"]);
        const container = document.getElementById("selectedColumnsContainer");

        function updateHiddenInputs() {
            container.innerHTML = "";
            selectedColumns.forEach(col => {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "SelectedColumns";
                input.value = col;
                container.appendChild(input);
            });
        }

        document.querySelectorAll(".toggle-column").forEach(btn => {
            const col = btn.dataset.column;
            btn.classList.add("btn-primary");

            btn.addEventListener("click", () => {
                if (selectedColumns.has(col)) {
                    selectedColumns.delete(col);
                    btn.classList.remove("btn-primary");
                    btn.classList.add("btn-outline-primary");
                } else {
                    selectedColumns.add(col);
                    btn.classList.add("btn-primary");
                    btn.classList.remove("btn-outline-primary");
                }

                updateHiddenInputs();
            });
        });

        updateHiddenInputs();
    </script>
}