@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<style>
    body, html {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    .login-wrapper {
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(6px);
        background: rgba(0, 0, 0, 0.4);
    }

    .login-card {
        background: rgba(48, 37, 30, 0.92);
        padding: 40px;
        border-radius: 30px;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
        width: 100%;
        max-width: 420px;
        text-align: center;
        color: #fff;
    }

    .login-card h2 {
        color: #ffc107;
        font-size: 26px;
        margin-bottom: 25px;
        font-weight: bold;
        letter-spacing: 1px;
    }

    .form-group {
        position: relative;
        margin-bottom: 25px;
    }

    .form-group input {
        width: 100%;
        padding: 12px 45px 12px 45px;
        border-radius: 50px;
        border: none;
        outline: none;
        font-size: 16px;
        background: #fff;
        color: #333;
    }

    .form-group .icon {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        left: 15px;
        font-size: 18px;
        color: #888;
    }

    .btn-login {
        background-color: #ffffff;
        color: #000;
        border: none;
        padding: 12px;
        font-weight: bold;
        font-size: 16px;
        width: 100%;
        border-radius: 50px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .btn-login:hover {
        background-color: #e5e5e5;
    }

    .text-links a {
        color: #ffc107;
        font-size: 14px;
        display: block;
        margin-top: 10px;
    }

    .validation-summary-errors {
        background-color: #dc3545;
        padding: 10px;
        color: white;
        border-radius: 8px;
        margin-bottom: 15px;
        font-size: 14px;
    }
</style>

<div class="login-wrapper">
    <div class="login-card">
        <h2>🔐 LOGIN</h2>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <div class="form-group">
                <span class="icon">📧</span>
                <input asp-for="Input.Email" placeholder="Email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="icon">🔒</span>
                <input asp-for="Input.Password" placeholder="Password" type="password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group text-start">
                <label class="form-check-label">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    Remember me
                </label>
            </div>

            <button type="submit" class="btn-login">Login</button>

            <div class="text-links mt-3">
                <a asp-page="./ForgotPassword">Forgot your password?</a>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
                <a asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
